<?xml version="1.0"?>
<package format="3">
  <name>oap_runner</name>
  <version>0.1.0</version>
  <description>AIRoA-0 policy inference on OpenArm: cameras and state to hand pose chunks and finger commands</description>
  <maintainer email="ext-oss@airoa.org">AIRoA</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
