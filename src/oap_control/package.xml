<?xml version="1.0"?>
<package format="3">
  <name>oap_control</name>
  <version>0.1.0</version>
  <description>ros2_control chain for both OpenArm arms: hand pose chunks → in-controller DLS IK → torque feedforward</description>
  <maintainer email="ext-oss@airoa.org">AIRoA</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>eigen</build_depend>
  <depend>ament_index_cpp</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <!-- rosdep installs ros-humble-pinocchio; docker/Dockerfile instead builds pinocchio 4.0.0 from source with casadi
       support (oap_planner needs pinocchio.casadi), and CMake finds that build through CMAKE_PREFIX_PATH -->
  <depend>pinocchio</depend>
  <depend>oap_description</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>oap_gripper</exec_depend>
  <!-- hardware:=real loads openarm_hardware/OpenArm_v10HW, which has no rosdep key: docker/Dockerfile builds
       openarm_hardware from openarm_ros2 0.9.2 with docker/patches applied -->
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
