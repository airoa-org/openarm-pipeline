<?xml version="1.0"?>
<package format="3">
  <name>oap_gui</name>
  <version>0.1.0</version>
  <description>One window for an OpenArm run: control chain, moves, policy, camera views, bag</description>
  <maintainer email="ext-oss@airoa.org">AIRoA</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>oap_planner</exec_depend>
  <!-- the window starts ros2 launch oap_control and ros2 run oap_runner -->
  <exec_depend>oap_control</exec_depend>
  <exec_depend>oap_runner</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
