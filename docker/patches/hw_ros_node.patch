+// AIRoA: rclcpp is initialized by controller_manager. oap_planner and oap_gui
+// address the node as /openarm_hw_relax_<side>.
+void OpenArm_v10HW::start_ros_node() {
+  if (ros_node_ || !rclcpp::ok()) {
+    return;
+  }
+  std::string tag = arm_prefix_;
+  if (!tag.empty() && tag.back() == '_') {
+    tag.pop_back();
+  }
+  if (tag.empty()) {
+    tag = "single";
+  }
+  ros_node_ = std::make_shared<rclcpp::Node>("openarm_hw_relax_" + tag);
+  ros_exec_ = std::make_unique<rclcpp::executors::SingleThreadedExecutor>();
+  ros_exec_->add_node(ros_node_);
+  ros_spin_thread_ = std::thread([this]() { ros_exec_->spin(); });
+}
+
+void OpenArm_v10HW::stop_ros_node() {
+  if (ros_exec_) {
+    ros_exec_->cancel();
+  }
+  if (ros_spin_thread_.joinable()) {
+    ros_spin_thread_.join();
+  }
+  ros_node_.reset();
+  ros_exec_.reset();
+}
