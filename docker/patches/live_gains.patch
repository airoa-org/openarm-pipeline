+// AIRoA
+void OpenArm_v10HW::start_live_gains() {
+  live_gains_param_cb_ = ros_node_->add_on_set_parameters_callback(
+      [this](const std::vector<rclcpp::Parameter>& params) {
+        rcl_interfaces::msg::SetParametersResult result;
+        result.successful = true;
+        for (const auto& p : params) {
+          if (p.get_name() == "gain_ramp_s") {
+            const double v = p.as_double();
+            if (v < 0.05 || v > 10.0) {
+              result.successful = false;
+              result.reason = "gain_ramp_s must be in [0.05, 10]";
+            } else {
+              gain_ramp_s_.store(v);
+            }
+          } else if (!set_gains(p, result)) {
+            break;
+          }
+        }
+        return result;
+      });
+  ros_node_->declare_parameter("kp_joints", kp_);
+  ros_node_->declare_parameter("kd_joints", kd_);
+  ros_node_->declare_parameter("gain_ramp_s", gain_ramp_s_.load());
+  // Manual, to move the arm by hand: the torque controller's effort command is gravity while motion holds.
+  manual_srv_ = ros_node_->create_service<std_srvs::srv::SetBool>(
+      "~/set_manual",
+      [this](const std::shared_ptr<std_srvs::srv::SetBool::Request> req,
+             std::shared_ptr<std_srvs::srv::SetBool::Response> res) {
+        set_manual(req->data);
+        res->success = true;
+        res->message = req->data ? "manual ON: kp ramps to 0, damping and gravity kept"
+                                 : "manual OFF: kp ramps back";
+        RCLCPP_WARN(rclcpp::get_logger("OpenArm_v10HW"), "%s",
+                    res->message.c_str());
+      });
+  gains_pub_ = ros_node_->create_publisher<std_msgs::msg::Float64MultiArray>(
+      "~/gains", rclcpp::QoS(1).transient_local());
+  gains_timer_ = ros_node_->create_wall_timer(
+      std::chrono::seconds(1), [this]() {
+        std_msgs::msg::Float64MultiArray msg;
+        msg.layout.dim.resize(2);
+        msg.layout.dim[0].label = "kp";
+        msg.layout.dim[0].size = ARM_DOF;
+        msg.layout.dim[0].stride = ARM_DOF;
+        msg.layout.dim[1].label = "kd";
+        msg.layout.dim[1].size = ARM_DOF;
+        msg.layout.dim[1].stride = ARM_DOF;
+        for (size_t i = 0; i < ARM_DOF; ++i) {
+          msg.data.push_back(kp_target_[i].load());
+        }
+        for (size_t i = 0; i < ARM_DOF; ++i) {
+          msg.data.push_back(kd_target_[i].load());
+        }
+        gains_pub_->publish(msg);
+      });
+}
+
+// AIRoA: rejects rather than clamps, because the MIT frame clamps silently.
+bool OpenArm_v10HW::set_gains(
+    const rclcpp::Parameter& p,
+    rcl_interfaces::msg::SetParametersResult& result) {
+  const std::string& name = p.get_name();
+  const bool is_kp = name == "kp_joints";
+  if (!is_kp && name != "kd_joints") {
+    return true;
+  }
+  const std::vector<double> g = p.as_double_array();
+  if (g.size() != ARM_DOF) {
+    result.successful = false;
+    result.reason = name + " needs " + std::to_string(ARM_DOF) + " values";
+    return false;
+  }
+  const double limit = is_kp ? MAX_KP : MAX_KD;
+  for (size_t i = 0; i < ARM_DOF; ++i) {
+    if (!(g[i] >= 0.0) || g[i] > limit) {
+      result.successful = false;
+      result.reason = name + "[" + std::to_string(i) + "]=" +
+                      std::to_string(g[i]) + " outside 0.." +
+                      std::to_string(limit);
+      return false;
+    }
+  }
+  for (size_t i = 0; i < ARM_DOF; ++i) {
+    (is_kp ? kp_target_ : kd_target_)[i].store(g[i]);
+  }
+  gains_gen_.fetch_add(1);
+  RCLCPP_WARN(rclcpp::get_logger("OpenArm_v10HW"),
+              "%s = [%.2f %.2f %.2f %.2f %.2f %.2f %.2f] (ramping over %.2fs)",
+              name.c_str(), g[0], g[1], g[2], g[3], g[4], g[5], g[6],
+              gain_ramp_s_.load());
+  return true;
+}
+
+// AIRoA: changing the gains at once could cause abrupt motion, so ramp them.
+void OpenArm_v10HW::set_manual(bool on) {
+  if (manual_.exchange(on) != on) {
+    gains_gen_.fetch_add(1);
+  }
+}
+
+void OpenArm_v10HW::step_gain_ramp(double dt) {
+  const uint64_t gen = gains_gen_.load();
+  if (gen != gains_gen_seen_) {
+    gains_gen_seen_ = gen;
+    kp_from_ = kp_now_;
+    kd_from_ = kd_now_;
+    for (size_t i = 0; i < ARM_DOF; ++i) {
+      kp_to_[i] = manual_.load() ? 0.0 : kp_target_[i].load();
+      kd_to_[i] = kd_target_[i].load();
+    }
+    ramp_t_ = 0.0;
+  }
+  ramp_t_ += std::max(dt, 0.0);
+  const double a = std::min(1.0, ramp_t_ / gain_ramp_s_.load());
+  for (size_t i = 0; i < ARM_DOF; ++i) {
+    kp_now_[i] = kp_from_[i] + a * (kp_to_[i] - kp_from_[i]);
+    kd_now_[i] = kd_from_[i] + a * (kd_to_[i] - kd_from_[i]);
+  }
+}
