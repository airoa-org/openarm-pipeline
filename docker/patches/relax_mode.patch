+// AIRoA
+void OpenArm_v10HW::start_relax() {
+  relax_srv_ = ros_node_->create_service<std_srvs::srv::SetBool>(
+      "~/set_relax",
+      [this](const std::shared_ptr<std_srvs::srv::SetBool::Request> req,
+             std::shared_ptr<std_srvs::srv::SetBool::Response> res) {
+        if (req->data) {
+          relax_mode_.store(true);
+          res->message = "relax ON: Kp=0, arm sinks under gravity (damped)";
+        } else {
+          // write() goes back to tracking pos_commands_, which the torque
+          // controller sets every cycle from motion's command. Callers
+          // (oap_planner, oap_gui) call /arm/hold before and after this so
+          // that command is the measured pose. write() itself puts
+          // pos_commands_ on the measured pose on the first cycle out of
+          // relax (this thread does not touch it), which holds the arm when
+          // no controller writes pos_commands_.
+          relax_mode_.store(false);
+          res->message = "relax OFF: tracking the commanded pose";
+        }
+        res->success = true;
+        RCLCPP_WARN(rclcpp::get_logger("OpenArm_v10HW"), "%s",
+                    res->message.c_str());
+      });
+  relax_param_cb_ = ros_node_->add_on_set_parameters_callback(
+      [this](const std::vector<rclcpp::Parameter>& params) {
+        rcl_interfaces::msg::SetParametersResult result;
+        result.successful = true;
+        for (const auto& p : params) {
+          if (p.get_name() != "relax_kd") {
+            continue;
+          }
+          const std::vector<double> v = p.as_double_array();
+          bool ok = v.size() == ARM_DOF;
+          for (size_t i = 0; ok && i < ARM_DOF; ++i) {
+            ok = v[i] > 0.0 && v[i] <= RELAX_MAX_KD;
+          }
+          if (!ok) {
+            result.successful = false;
+            result.reason = "relax_kd needs 7 values in (0, 5]";
+            break;
+          }
+          for (size_t i = 0; i < ARM_DOF; ++i) {
+            relax_kd_[i].store(v[i]);
+          }
+        }
+        return result;
+      });
+  std::vector<double> kd0(ARM_DOF);
+  for (size_t i = 0; i < ARM_DOF; ++i) {
+    kd0[i] = relax_kd_[i].load();
+  }
+  ros_node_->declare_parameter("relax_kd", kd0);
+  RCLCPP_INFO(rclcpp::get_logger("OpenArm_v10HW"),
+              "relax service ready: /%s/set_relax", ros_node_->get_name());
+}
