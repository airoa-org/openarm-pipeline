+// AIRoA: ros2_control calls on_shutdown at a normal exit (after on_deactivate
+// for an active arm) and on_error when a transition fails. Neither runs, and
+// neither does the destructor, when ros2_control_node dies on an uncaught
+// exception (e.g. the controller manager failing to activate the other arm):
+// check_presence() exists so that a missing motor fails before any arm is
+// enabled.
+hardware_interface::CallbackReturn OpenArm_v10HW::on_shutdown(
+    const rclcpp_lifecycle::State& /*previous_state*/) {
+  disable_motors();
+  return CallbackReturn::SUCCESS;
+}
