+void OpenArm_v10HW::disable_motors() {
+  if (!openarm_ || !motors_enabled_) {
+    return;
+  }
+  motors_enabled_ = false;
+  // Confirmed when every arm motor has sent a state since the disable went out
+  // and that state reports it disabled (the status nibble of the frame).
+  // openarm_can never throws on a failed write, it only counts it, so a lost
+  // frame shows up as no confirmation: send the disable again, up to 3 times.
+  const auto write_failures = [this]() {
+    const auto& bus = openarm_->get_bus_status();
+    return bus.write_net_down.count + bus.write_no_buffer.count +
+           bus.write_other.count;
+  };
+  const uint64_t failures0 = write_failures();
+  std::array<bool, ARM_DOF> off{};
+  bool all_off = false;
+  int attempts = 0;
+  try {  // nothing may throw out of the destructor
+    openarm_->set_callback_mode_all(openarm::damiao_motor::CallbackMode::STATE);
+    while (!all_off && attempts < 3) {
+      ++attempts;
+      std::array<int64_t, ARM_DOF> before{};
+      for (size_t i = 0; i < ARM_DOF; ++i) {
+        before[i] = state_replies(i);
+      }
+      openarm_->disable_all();
+      const auto deadline =
+          std::chrono::steady_clock::now() + std::chrono::milliseconds(20);
+      while (!all_off && std::chrono::steady_clock::now() < deadline) {
+        openarm_->recv_all(500);
+        const auto& motors = openarm_->get_arm().get_motors();
+        all_off = true;
+        for (size_t i = 0; i < ARM_DOF && i < motors.size(); ++i) {
+          off[i] = off[i] ||
+                   (state_replies(i) > before[i] && !motors[i].is_enabled());
+          all_off = all_off && off[i];
+        }
+      }
+    }
+  } catch (const std::exception& e) {
+    RCLCPP_ERROR(rclcpp::get_logger("OpenArm_v10HW"),
+                 "[link %s] disabling the motors: %s", can_interface_.c_str(),
+                 e.what());
+  }
+  const uint64_t failed_writes = write_failures() - failures0;
+  if (all_off && failed_writes == 0) {
+    RCLCPP_INFO(rclcpp::get_logger("OpenArm_v10HW"),
+                "[link %s] motors disabled (confirmed)", can_interface_.c_str());
+    return;
+  }
+  std::string missing;
+  for (size_t i = 0; i < ARM_DOF; ++i) {
+    if (!off[i]) {
+      missing += " j" + std::to_string(i + 1);
+    }
+  }
+  RCLCPP_ERROR(rclcpp::get_logger("OpenArm_v10HW"),
+               "[link %s] disable sent %d time(s), %llu CAN write(s) failed; "
+               "not confirmed disabled:%s -- check the arm, e-stop if needed",
+               can_interface_.c_str(), attempts,
+               static_cast<unsigned long long>(failed_writes),
+               missing.empty() ? " (none)" : missing.c_str());
+}
+
+// AIRoA: ros2_control initializes every hardware component before it
+// configures and activates them one by one, and a component that fails here
+// leaves its interfaces missing, so the controller manager stops before
+// enabling either arm. Each motor is asked for a parameter (its master ID)
+// while still disabled -- openarm_can's own `discover` command finds motors
+// the same way -- and every reply routed to it counts in its link stats.
+bool OpenArm_v10HW::check_presence() {
+  std::array<uint64_t, ARM_DOF> before{};
+  for (size_t i = 0; i < ARM_DOF; ++i) {
+    before[i] =
+        openarm_->get_arm().get_link_stats(static_cast<int>(i)).responses;
+  }
+  openarm_->set_callback_mode_all(openarm::damiao_motor::CallbackMode::PARAM);
+  bool all = false;
+  for (int attempt = 0; attempt < 3 && !all; ++attempt) {
+    openarm_->get_arm().query_param_all(
+        static_cast<int>(openarm::damiao_motor::RID::MST_ID));
+    const auto deadline =
+        std::chrono::steady_clock::now() + std::chrono::milliseconds(20);
+    while (!all && std::chrono::steady_clock::now() < deadline) {
+      openarm_->recv_all(500);
+      all = true;
+      for (size_t i = 0; i < ARM_DOF; ++i) {
+        all = all && openarm_->get_arm()
+                             .get_link_stats(static_cast<int>(i))
+                             .responses > before[i];
+      }
+    }
+  }
+  openarm_->set_callback_mode_all(openarm::damiao_motor::CallbackMode::STATE);
+  for (size_t i = 0; i < ARM_DOF; ++i) {
+    if (openarm_->get_arm().get_link_stats(static_cast<int>(i)).responses ==
+        before[i]) {
+      RCLCPP_ERROR(rclcpp::get_logger("OpenArm_v10HW"),
+                   "[link %s] joint %zu did not answer a parameter query: not "
+                   "starting (check its power, CAN ID and wiring)",
+                   can_interface_.c_str(), i + 1);
+    }
+  }
+  return all;
+}
