+// AIRoA: per motor, the longest gap between two replies, reported every 10 s. A motor that misses over link_fault_cycles
+// replies in a row, or reports an error code, relaxes the arm. Cycles, not time: write() pauses ~200 ms while the other
+// arm activates. Misses count from activation, which seeds link_seen_ with each motor's last reply; gaps count from the
+// first reply after it, so the wait for the first write() (the other arm's activation, controller start) is not one.
+void OpenArm_v10HW::monitor_link() {
+  const auto now = std::chrono::steady_clock::now();
+  const auto& motors = openarm_->get_arm().get_motors();
+  for (size_t i = 0; i < ARM_DOF && i < motors.size(); ++i) {
+    const auto last = openarm_->get_arm().get_link_stats(static_cast<int>(i)).last_response;
+    if (last != link_seen_[i]) {
+      if (link_gap_armed_[i]) {
+        link_max_gap_ms_[i] = std::max(link_max_gap_ms_[i],
+                                       std::chrono::duration<double, std::milli>(last - link_seen_[i]).count());
+      }
+      link_gap_armed_[i] = true;
+      link_seen_[i] = last;
+      link_missed_[i] = 0;
+    } else {
+      ++link_missed_[i];
+    }
+    const uint8_t err = motors[i].get_error_code();
+    if (motors[i].has_error() && err != link_error_[i]) {
+      RCLCPP_ERROR(rclcpp::get_logger("OpenArm_v10HW"), "[link %s] joint %zu reports error 0x%X",
+                   can_interface_.c_str(), i + 1, err);
+    }
+    link_error_[i] = err;
+    if (motors[i].has_error()) {
+      link_fault("an error code", i);
+    } else if (link_fault_cycles_ > 0 && link_missed_[i] > link_fault_cycles_) {
+      link_fault("no reply", i);
+    }
+  }
+  if (link_report_.time_since_epoch().count() == 0) {
+    link_report_ = now;
+  } else if (now - link_report_ > std::chrono::seconds(10)) {
+    char line[160];
+    int n = 0;
+    for (size_t i = 0; i < ARM_DOF; ++i) {
+      n += std::snprintf(line + n, sizeof(line) - n, " %.1f", link_max_gap_ms_[i]);
+      link_max_gap_ms_[i] = 0.0;
+    }
+    RCLCPP_INFO(rclcpp::get_logger("OpenArm_v10HW"), "[link %s] longest reply gap j1-j7 [ms]:%s",
+                can_interface_.c_str(), line);
+    link_report_ = now;
+  }
+}
+
+// motion trips once the relaxed arm sinks; relax OFF re-arms the check.
+void OpenArm_v10HW::link_fault(const char* why, size_t joint) {
+  if (relax_mode_.exchange(true)) {
+    return;
+  }
+  RCLCPP_ERROR(rclcpp::get_logger("OpenArm_v10HW"), "[link %s] joint %zu: %s, relax ON", can_interface_.c_str(),
+               joint + 1, why);
+}
